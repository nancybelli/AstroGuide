<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AstraSky - Free Birth Charts & Daily Astrology</title>
    <style>
        :root {
            --bg-deep: #0b0c10;
            --bg-card: #1f2833;
            --accent-gold: #c5a059;
            --accent-cyan: #66fcf1;
            --text-main: #c5c6c7;
            --text-light: #ffffff;
            --text-muted: #86888a;
            --harmony-good: #2ecc71;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            line-height: 1.6;
            padding-bottom: 60px;
        }

        header {
            background: linear-gradient(135deg, #12161a 0%, #1f2833 100%);
            padding: 30px 20px;
            text-align: center;
            border-bottom: 2px solid var(--accent-gold);
        }

        header h1 {
            color: var(--text-light);
            font-size: 2.5rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        header h1 span {
            color: var(--accent-gold);
        }

        header p {
            color: var(--accent-cyan);
            font-size: 1.1rem;
            margin-top: 5px;
        }

        main {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        @media (max-width: 900px) {
            main {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background-color: var(--bg-card);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            border: 1px solid rgba(197, 160, 89, 0.1);
        }

        .panel h2 {
            color: var(--text-light);
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 10px;
            font-size: 1.5rem;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tab-btn {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--text-muted);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: var(--accent-gold);
            color: var(--bg-deep);
            border-color: var(--accent-gold);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-light);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            background-color: #0b0c10;
            border: 1px solid var(--text-muted);
            border-radius: 6px;
            color: var(--text-light);
            font-size: 1rem;
        }

        .lead-box {
            background: rgba(197, 160, 89, 0.05);
            border: 1px solid var(--accent-gold);
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
            display: none;
            text-align: center;
        }

        .results-box {
            background: #0b0c10;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid rgba(102, 252, 241, 0.2);
            display: none;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 20px;
            text-align: center;
        }

        .chart-item {
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 6px;
            border: 1px solid rgba(197, 160, 89, 0.2);
        }

        .chart-item span {
            display: block;
            font-size: 0.8rem;
            text-transform: uppercase;
            color: var(--accent-cyan);
        }

        .chart-item strong {
            font-size: 1.2rem;
            color: var(--text-light);
        }

        .btn {
            width: 100%;
            padding: 15px;
            background-color: var(--accent-gold);
            color: var(--bg-deep);
            border: none;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

        .btn:hover { background-color: #dfb76c; }

        .report-card {
            background: rgba(11, 12, 16, 0.6);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .report-title { color: var(--text-light); font-size: 1.2rem; font-weight: bold; }
        .report-price { color: var(--accent-gold); font-size: 1.3rem; font-weight: bold; }
    </style>
</head>
<body>

    <header>
        <h1>Astra<span>Sky</span></h1>
        <p>Free Birth Charts, Daily Horoscopes & Premium Transitions</p>
    </header>

    <main>
        <!-- Panel 1: Free Astrological Features -->
        <div class="panel">
            <div class="tabs">
                <button class="tab-btn active" id="tabChart" onclick="switchTab('chart')">Birth Chart Calculator</button>
                <button class="tab-btn" id="tabDaily" onclick="switchTab('daily')">Daily Horoscope</button>
            </div>

            <!-- Birth Chart Form Interface -->
            <div id="sectionChart">
                <h2>Calculate Your Free Chart</h2>
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="chartName" placeholder="Your Name">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Birth Date</label>
                        <input type="date" id="chartDate">
                    </div>
                    <div class="form-group">
                        <label>Birth Time</label>
                        <input type="time" id="chartTime">
                    </div>
                </div>
                <button class="btn" onclick="processFreeRequest('chart')">Calculate My Placements</button>
            </div>

            <!-- Daily Horoscope Interface -->
            <div id="sectionDaily" style="display: none;">
                <h2>Your Free Daily Alignment</h2>
                <div class="form-group">
                    <label>Select Your Zodiac Sign</label>
                    <select id="dailySign">
                        <option value="Aries">Aries</option>
                        <option value="Taurus">Taurus</option>
                        <option value="Gemini">Gemini</option>
                        <option value="Cancer">Cancer</option>
                        <option value="Leo">Leo</option>
                        <option value="Virgo">Virgo</option>
                        <option value="Libra">Libra</option>
                        <option value="Scorpio">Scorpio</option>
                        <option value="Sagittarius">Sagittarius</option>
                        <option value="Capricorn">Capricorn</option>
                        <option value="Aquarius">Aquarius</option>
                        <option value="Pisces">Pisces</option>
                    </select>
                </div>
                <button class="btn" onclick="processFreeRequest('daily')">Reveal Today's Horoscope</button>
            </div>

            <!-- Unified Email Lead Gate -->
            <div class="lead-box" id="leadGate">
                <h3 style="color: var(--text-light); margin-bottom: 10px;">Unlock Your Cosmic Profile</h3>
                <p style="font-size: 0.85rem; margin-bottom: 15px;">Enter your email to verify your user profile and unlock instant calculations.</p>
                <input type="email" id="leadEmail" placeholder="name@example.com" style="margin-bottom: 15px;">
                <button class="btn" style="padding: 10px; font-size: 0.95rem;" onclick="submitLeadData()">Access Free Analysis</button>
            </div>

            <!-- Calculation Output Display -->
            <div class="results-box" id="resultsBox">
                <div id="chartOutput" style="display: none;">
                    <h3 style="color: var(--accent-gold); margin-bottom: 15px;">Your Calculated Core Triad</h3>
                    <div class="chart-grid">
                        <div class="chart-item"><span>Sun Sign</span><strong id="resSun">-</strong></div>
                        <div class="chart-item"><span>Moon Sign</span><strong id="resMoon">-</strong></div>
                        <div class="chart-item"><span>Rising Sign</span><strong id="resRising">-</strong></div>
                    </div>
                    <p style
